{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "game-nav",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-nav-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
